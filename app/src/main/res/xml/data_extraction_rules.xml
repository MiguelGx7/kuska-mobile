<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Los tokens de sesión no se respaldan ni se transfieren. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sesion.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
