<?xml version="1.0" encoding="utf-8"?>
<!-- El startDestination real lo fija MainActivity según la sesión y el rol. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.proyecto.kuska.ui.login.LoginFragment"
        android:label="@string/titulo_login">
        <action
            android:id="@+id/action_login_a_registro"
            app:destination="@id/registroFragment" />
        <action
            android:id="@+id/action_login_a_recuperar"
            app:destination="@id/recuperarFragment" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.proyecto.kuska.ui.registro.RegistroFragment"
        android:label="@string/titulo_registro" />

    <fragment
        android:id="@+id/recuperarFragment"
        android:name="com.proyecto.kuska.ui.recuperar.RecuperarFragment"
        android:label="@string/titulo_recuperar">
        <!-- Correo que ya estaba escrito en el Login (puede venir vacío) -->
        <argument
            android:name="correo"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <!-- Beneficiario -->
    <fragment
        android:id="@+id/inicioBeneficiarioFragment"
        android:name="com.proyecto.kuska.ui.iniciobeneficiario.InicioBeneficiarioFragment"
        android:label="@string/titulo_inicio_beneficiario">
        <action
            android:id="@+id/action_inicio_beneficiario_a_detalle_alimento"
            app:destination="@id/detalleAlimentoFragment" />
    </fragment>

    <!-- No hay endpoint de detalle: recibe el alimento de la lista como JSON. Devuelve el resultado en el
         SavedStateHandle de la lista (agregado o recargar). -->
    <fragment
        android:id="@+id/detalleAlimentoFragment"
        android:name="com.proyecto.kuska.ui.detallealimento.DetalleAlimentoFragment"
        android:label="@string/titulo_detalle_alimento">
        <argument
            android:name="alimento"
            app:argType="string" />
    </fragment>

    <!-- Cambiar cantidad y el éxito del envío son diálogos hijos; "Ir a Inicio" y "Ver mis solicitudes" cambian de
         pestaña en la barra inferior. -->
    <fragment
        android:id="@+id/carritoFragment"
        android:name="com.proyecto.kuska.ui.carrito.CarritoFragment"
        android:label="@string/titulo_carrito" />

    <fragment
        android:id="@+id/misSolicitudesFragment"
        android:name="com.proyecto.kuska.ui.missolicitudes.MisSolicitudesFragment"
        android:label="@string/titulo_mis_solicitudes" />

    <!-- Donante -->
    <fragment
        android:id="@+id/inicioDonanteFragment"
        android:name="com.proyecto.kuska.ui.iniciodonante.InicioDonanteFragment"
        android:label="@string/titulo_inicio_donante" />

    <fragment
        android:id="@+id/misDonacionesFragment"
        android:name="com.proyecto.kuska.ui.misdonaciones.MisDonacionesFragment"
        android:label="@string/titulo_mis_donaciones">
        <action
            android:id="@+id/action_mis_donaciones_a_crear_donacion"
            app:destination="@id/nav_crear_donacion" />
        <action
            android:id="@+id/action_mis_donaciones_a_detalle"
            app:destination="@id/detalleDonacionFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleDonacionFragment"
        android:name="com.proyecto.kuska.ui.detalledonacion.DetalleDonacionFragment"
        android:label="@string/titulo_detalle_donacion">
        <argument
            android:name="id"
            app:argType="integer" />
        <action
            android:id="@+id/action_detalle_a_editar"
            app:destination="@id/editarDonacionFragment" />
        <action
            android:id="@+id/action_detalle_a_agregar_alimento"
            app:destination="@id/agregarAlimentoFragment" />
    </fragment>

    <!-- Solo para una donación Pendiente (RN-12). Cada una tiene su propio ViewModel. -->
    <fragment
        android:id="@+id/editarDonacionFragment"
        android:name="com.proyecto.kuska.ui.editardonacion.EditarDonacionFragment"
        android:label="@string/titulo_editar_donacion">
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/agregarAlimentoFragment"
        android:name="com.proyecto.kuska.ui.agregaralimento.AgregarAlimentoFragment"
        android:label="@string/titulo_agregar_alimento">
        <argument
            android:name="id"
            app:argType="integer" />
    </fragment>

    <!-- Registrar donación: las dos pantallas comparten CrearDonacionViewModel (navGraphViewModels). -->
    <navigation
        android:id="@+id/nav_crear_donacion"
        app:startDestination="@id/crearDonacionFragment">

        <fragment
            android:id="@+id/crearDonacionFragment"
            android:name="com.proyecto.kuska.ui.creardonacion.CrearDonacionFragment"
            android:label="@string/titulo_crear_donacion">
            <action
                android:id="@+id/action_crear_donacion_a_alimento"
                app:destination="@id/alimentoFragment" />
        </fragment>

        <fragment
            android:id="@+id/alimentoFragment"
            android:name="com.proyecto.kuska.ui.creardonacion.AlimentoFragment"
            android:label="@string/titulo_agregar_alimento">
            <!-- Posición del alimento a editar; -1 = alimento nuevo -->
            <argument
                android:name="indice"
                android:defaultValue="-1"
                app:argType="integer" />
        </fragment>
    </navigation>

    <!-- Común -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.proyecto.kuska.ui.perfil.PerfilFragment"
        android:label="@string/titulo_perfil">
        <action
            android:id="@+id/action_perfil_a_editar"
            app:destination="@id/editarPerfilFragment" />
        <action
            android:id="@+id/action_perfil_a_cambiar_contrasena"
            app:destination="@id/cambiarContrasenaFragment" />
    </fragment>

    <!-- Las dos devuelven el mensaje de éxito en el SavedStateHandle de Perfil -->
    <fragment
        android:id="@+id/editarPerfilFragment"
        android:name="com.proyecto.kuska.ui.editarperfil.EditarPerfilFragment"
        android:label="@string/titulo_editar_perfil" />

    <fragment
        android:id="@+id/cambiarContrasenaFragment"
        android:name="com.proyecto.kuska.ui.cambiarcontrasena.CambiarContrasenaFragment"
        android:label="@string/titulo_cambiar_contrasena" />
</navigation>
