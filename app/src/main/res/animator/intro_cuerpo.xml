<?xml version="1.0" encoding="utf-8"?>
<!--
  Rebote del cuerpo mientras camina: sube 4dp (≈3,08 en el viewBox, escala 1,3) y baja, ciclo de 250 ms.
  Empieza a los 120 ms (TiemposIntro.ENTRADA) y dura los 1,5 s de la caminata: 12 medios ciclos (6 completos).
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="125"
    android:interpolator="@android:interpolator/accelerate_decelerate"
    android:propertyName="translateY"
    android:repeatCount="11"
    android:repeatMode="reverse"
    android:startOffset="120"
    android:valueFrom="0"
    android:valueTo="-3.08"
    android:valueType="floatType" />
