<?xml version="1.0" encoding="utf-8"?>
<!--
  Estado vacío: la hormiga junto a un plato vacío. Convertida de HormigaVacia.jsx del panel (viewBox 200x180)
  sin cambiar la construcción. La sombra y el plato usan colores del tema (claro y oscuro).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="144dp"
    android:viewportWidth="200"
    android:viewportHeight="180">

    <!-- Sombra -->
    <path
        android:fillColor="@color/kumora_outline_variant"
        android:pathData="M30,168 a80,6 0 1,0 160,0 a80,6 0 1,0 -160,0 Z" />
    <!-- La hormiga, desplazada y reducida como en el panel: translate(-22,14) scale(0.85) -->
    <group
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateX="-22"
        android:translateY="14">

        <!-- Patas y antenas -->
        <path
            android:pathData="M90,132 L78,162 M100,136 L100,164 M110,132 L124,160 M120,62 Q112,38 98,32 M144,60 Q152,36 168,30"
            android:strokeWidth="6"
            android:strokeColor="#1250AA"
            android:strokeLineCap="round" />
        <!-- Puntas de las antenas -->
        <path
            android:fillColor="#FFC233"
            android:pathData="M92,32 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z M162,30 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />
        <!-- Abdomen y brillo -->
        <path
            android:fillColor="#1766D6"
            android:pathData="M28,118 a34,30 0 1,0 68,0 a34,30 0 1,0 -68,0 Z" />
        <path
            android:fillColor="#5B9BF0"
            android:pathData="M40,106 a10,6 0 1,0 20,0 a10,6 0 1,0 -20,0 Z" />
        <!-- Tórax y cabeza -->
        <path
            android:fillColor="#1250AA"
            android:pathData="M84,122 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />
        <path
            android:fillColor="#1766D6"
            android:pathData="M98,92 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 Z" />
        <!-- Ojos -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M112,88 a9,11 0 1,0 18,0 a9,11 0 1,0 -18,0 Z M136,88 a9,11 0 1,0 18,0 a9,11 0 1,0 -18,0 Z" />
        <path
            android:fillColor="#101828"
            android:pathData="M120,93 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z M144,93 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
        <!-- Boca -->
        <path
            android:pathData="M128,108 Q134,106 140,108"
            android:strokeWidth="3"
            android:strokeColor="#101828"
            android:strokeLineCap="round" />
    </group>

    <!-- Plato vacío -->
    <path
        android:fillColor="@color/kumora_outline"
        android:pathData="M138,140 Q140,162 165,164 Q190,162 192,140 Z" />
    <path
        android:fillColor="@color/kumora_outline_variant"
        android:pathData="M138,140 a27,6 0 1,0 54,0 a27,6 0 1,0 -54,0 Z"
        android:strokeWidth="2"
        android:strokeColor="@color/kumora_outline" />
</vector>
