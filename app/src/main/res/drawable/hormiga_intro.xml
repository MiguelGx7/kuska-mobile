<?xml version="1.0" encoding="utf-8"?>
<!--
  Hormiga de la intro, convertida del SVG del diseño (viewBox 200x180). Colores fijos en ambos modos.
  Grupos con nombre para hormiga_intro_animada.xml: cuerpo (rebota; todo menos la sombra), pata_a1 / pata_b /
  pata_a2 (giran desde su punto superior), grano (salta) y ojos (parpadean, pivote entre los dos ojos).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="260dp"
    android:height="234dp"
    android:viewportWidth="200"
    android:viewportHeight="180">

    <!-- Sombra (no rebota) -->
    <path
        android:fillColor="#E4E7EC"
        android:pathData="M42,168 a58,6 0 1,0 116,0 a58,6 0 1,0 -116,0 Z" />

    <group android:name="cuerpo">

        <!-- Patas: A1 y A2 en fase, B en contrafase -->
        <group
            android:name="pata_a1"
            android:pivotX="90"
            android:pivotY="132">
            <path
                android:pathData="M90,132 L78,162"
                android:strokeWidth="6"
                android:strokeColor="#1250AA"
                android:strokeLineCap="round" />
        </group>

        <group
            android:name="pata_b"
            android:pivotX="100"
            android:pivotY="136">
            <path
                android:pathData="M100,136 L100,164"
                android:strokeWidth="6"
                android:strokeColor="#1250AA"
                android:strokeLineCap="round" />
        </group>

        <group
            android:name="pata_a2"
            android:pivotX="110"
            android:pivotY="132">
            <path
                android:pathData="M110,132 L124,160"
                android:strokeWidth="6"
                android:strokeColor="#1250AA"
                android:strokeLineCap="round" />
        </group>

        <!-- Antenas y sus puntas -->
        <path
            android:pathData="M120,62 Q112,38 98,32 M144,60 Q152,36 168,30"
            android:strokeWidth="6"
            android:strokeColor="#1250AA"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#FFC233"
            android:pathData="M92,32 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z M162,30 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z" />

        <!-- Abdomen y brillo -->
        <path
            android:fillColor="#1766D6"
            android:pathData="M28,118 a34,30 0 1,0 68,0 a34,30 0 1,0 -68,0 Z" />
        <path
            android:fillColor="#5B9BF0"
            android:pathData="M40,106 a10,6 0 1,0 20,0 a10,6 0 1,0 -20,0 Z" />

        <!-- Grano de maíz (salta al llegar) -->
        <group android:name="grano">
            <path
                android:fillColor="#FFC233"
                android:pathData="M46,92 Q42,68 60,60 Q78,68 74,92 Q60,99 46,92 Z"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFF" />
            <path
                android:pathData="M54,74 Q56,68 61,66"
                android:strokeWidth="3"
                android:strokeColor="#FFE39A"
                android:strokeLineCap="round" />
        </group>

        <!-- Tórax y cabeza -->
        <path
            android:fillColor="#1250AA"
            android:pathData="M84,122 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />
        <path
            android:fillColor="#1766D6"
            android:pathData="M98,92 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 Z" />

        <!-- Ojos (parpadean) -->
        <group
            android:name="ojos"
            android:pivotX="133"
            android:pivotY="88">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M112,88 a9,11 0 1,0 18,0 a9,11 0 1,0 -18,0 Z M136,88 a9,11 0 1,0 18,0 a9,11 0 1,0 -18,0 Z" />
            <path
                android:fillColor="#101828"
                android:pathData="M118,90 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z M142,90 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M123.2,87 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z M147.2,87 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z" />
        </group>

        <!-- Sonrisa -->
        <path
            android:pathData="M127,106 Q134,113 141,106"
            android:strokeWidth="3"
            android:strokeColor="#101828"
            android:strokeLineCap="round" />
    </group>
</vector>
