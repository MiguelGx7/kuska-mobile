<?xml version="1.0" encoding="utf-8"?>
<!-- Una categoría (HU-037): nombre y dos barras proporcionales (donados y entregados) con su número.
     El ancho de cada barra lo pone la pantalla con layout_weight (proporción); el resto queda libre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/texto_categoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Lácteos" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="1">

            <View
                android:id="@+id/barra_donados"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_leyenda"
                android:backgroundTint="?attr/colorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/numero_donados"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:weightSum="1">

            <View
                android:id="@+id/barra_entregados"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_leyenda"
                android:backgroundTint="?attr/colorTertiary" />
        </LinearLayout>

        <TextView
            android:id="@+id/numero_entregados"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="4" />
    </LinearLayout>
</LinearLayout>
