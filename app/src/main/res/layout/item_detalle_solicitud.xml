<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud recibida para un alimento (RN-15). Teléfono y dirección solo si la API los manda. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kumora.CardView.Borde"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/texto_beneficiario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Laura Gómez" />

            <TextView
                android:id="@+id/etiqueta_cancelado"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginStart="8dp"
                android:text="@string/detalle_cancelado"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/etiqueta_estado"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginStart="8dp"
                tools:text="Aprobada" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_cantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Pidió 2 kg" />

        <TextView
            android:id="@+id/texto_pedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Pedido KUM-20261016-0001" />

        <TextView
            android:id="@+id/texto_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="phone"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Teléfono: 3001234567" />

        <TextView
            android:id="@+id/texto_direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Dirección: Carrera 7 # 12-30" />

        <!-- Solo si la API manda estado_confirmacion (solicitud Entregada, RN-26b) -->
        <TextView
            android:id="@+id/texto_confirmacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Confirmación del beneficiario: Pendiente"
            tools:visibility="visible" />

        <!-- Solo Aprobada y no cancelada (RN-26) -->
        <FrameLayout
            android:id="@+id/contenedor_entregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/boton_entregar"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/entrega_boton" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/indicador_entregar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
