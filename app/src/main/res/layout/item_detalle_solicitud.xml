<?xml version="1.0" encoding="utf-8"?>
<!-- Solicitud recibida para un alimento (RN-15). Teléfono y dirección solo si la API los manda. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kumora.CardView.Borde"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/texto_beneficiario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Laura Gómez" />

            <TextView
                android:id="@+id/etiqueta_cancelado"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginStart="8dp"
                android:text="@string/detalle_cancelado"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/etiqueta_estado"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginStart="8dp"
                tools:text="Aprobada" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_cantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Pidió 2 kg" />

        <TextView
            android:id="@+id/texto_pedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Pedido KUM-20261016-0001" />

        <TextView
            android:id="@+id/texto_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoLink="phone"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Teléfono: 3001234567" />

        <TextView
            android:id="@+id/texto_direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Dirección: Carrera 7 # 12-30" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
