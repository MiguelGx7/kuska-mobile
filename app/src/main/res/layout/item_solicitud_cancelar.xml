<?xml version="1.0" encoding="utf-8"?>
<!-- Cancelar solicitud (solo Pendiente, RN-23): botón secundario de peligro con indicador de carga. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/boton_cancelar"
            style="@style/Widget.Kumora.Button.Peligro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/solicitud_cancelar" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/indicador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorError"
            app:indicatorSize="24dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
