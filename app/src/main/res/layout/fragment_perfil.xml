<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil (HU-012 a HU-015): datos de solo lectura, editar, cambiar contraseña y cerrar sesión. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.perfil.PerfilFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="@dimen/espacio_campana"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:text="@string/titulo_perfil"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/deslizar_refrescar"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/desplazamiento"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/contenido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Kumora.CardView.Borde"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Un item_dato_perfil por cada dato -->
                        <LinearLayout
                            android:id="@+id/contenedor_datos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <Button
                        android:id="@+id/boton_editar"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/perfil_editar" />

                    <Button
                        android:id="@+id/boton_cambiar_contrasena"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/perfil_cambiar_contrasena" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <Button
                            android:id="@+id/boton_cerrar_sesion"
                            style="@style/Widget.Kumora.Button.Peligro"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/perfil_cerrar_sesion" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/indicador_cerrar_sesion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="?attr/colorError"
                            app:indicatorSize="24dp"
                            app:trackThickness="3dp" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            android:id="@+id/estado_pantalla"
            layout="@layout/vista_estado_pantalla"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
