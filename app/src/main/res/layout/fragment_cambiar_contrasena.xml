<?xml version="1.0" encoding="utf-8"?>
<!-- Cambiar contraseña (HU-014). Las reglas de la nueva las valida el servidor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.cambiarcontrasena.CambiarContrasenaFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationContentDescription="@string/accion_volver"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/titulo_cambiar_contrasena" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perfil_contrasena_explicacion"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/Widget.Kumora.Etiqueta"
                android:labelFor="@id/entrada_actual"
                android:text="@string/perfil_contrasena_actual" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_actual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_candado">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_actual"
                    style="@style/Widget.Kumora.Entrada"
                    android:autofillHints="password"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Kumora.Etiqueta"
                android:labelFor="@id/entrada_nueva"
                android:text="@string/recuperar_contrasena_nueva" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_nueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_candado">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_nueva"
                    style="@style/Widget.Kumora.Entrada"
                    android:autofillHints="newPassword"
                    android:hint="@string/contrasena_nueva_placeholder"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.Kumora.Etiqueta"
                android:labelFor="@id/entrada_confirmar"
                android:text="@string/perfil_confirmar_nueva" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_confirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_candado">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_confirmar"
                    style="@style/Widget.Kumora.Entrada"
                    android:autofillHints="newPassword"
                    android:hint="@string/confirmar_contrasena_placeholder"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Empuja el aviso y el botón hacia abajo cuando sobra espacio -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <TextView
                android:id="@+id/aviso_error"
                style="@style/Widget.Kumora.AvisoError"
                android:layout_marginBottom="16dp"
                tools:text="No hay conexión. Revisa tu internet e inténtalo de nuevo."
                tools:visibility="visible" />

            <include
                android:id="@+id/boton_carga"
                layout="@layout/vista_boton_carga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
