<?xml version="1.0" encoding="utf-8"?>
<!-- Estado de pantalla completa: cargando, vacío o error con "Reintentar". Se usa con <include> y mostrarEstadoPantalla(). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/indicador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/cargando"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="40dp"
        app:trackThickness="4dp" />

    <LinearLayout
        android:id="@+id/contenedor_mensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/texto_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Aún no has registrado donaciones. Cuando registres una, aparecerá aquí." />

        <Button
            android:id="@+id/boton_reintentar"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/accion_reintentar" />
    </LinearLayout>
</FrameLayout>
