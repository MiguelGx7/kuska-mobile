<?xml version="1.0" encoding="utf-8"?>
<!-- Leyenda de dos series: color principal (primera) y terciario (segunda). Los textos los pone la pantalla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal">

    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/fondo_leyenda"
        android:backgroundTint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/texto_primera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Donaciones" />

    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/fondo_leyenda"
        android:backgroundTint="?attr/colorTertiary" />

    <TextView
        android:id="@+id/texto_segunda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Entregas" />
</LinearLayout>
