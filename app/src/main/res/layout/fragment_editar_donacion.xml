<?xml version="1.0" encoding="utf-8"?>
<!-- Editar los datos de una donación Pendiente. Mientras carga o si falla se ve vista_estado_pantalla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.editardonacion.EditarDonacionFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        app:navigationContentDescription="@string/accion_volver"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/titulo_editar_donacion" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/desplazamiento"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/datos"
                    layout="@layout/vista_datos_donacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Empuja el aviso y el botón hacia abajo cuando sobra espacio -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="32dp" />

                <TextView
                    android:id="@+id/aviso_error"
                    style="@style/Widget.Kumora.AvisoError"
                    android:layout_marginBottom="16dp"
                    tools:text="No hay conexión. Revisa tu internet e inténtalo de nuevo."
                    tools:visibility="visible" />

                <include
                    android:id="@+id/boton_carga"
                    layout="@layout/vista_boton_carga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/estado_pantalla"
            layout="@layout/vista_estado_pantalla"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
