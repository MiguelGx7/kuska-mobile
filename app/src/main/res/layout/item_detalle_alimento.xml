<?xml version="1.0" encoding="utf-8"?>
<!-- Alimento de la donación con su foto grande. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kumora.CardView.Borde"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imagen_foto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/estado_gris_fondo"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Kumora.Control" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/texto_nombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Arroz" />

            <TextView
                android:id="@+id/etiqueta_sin_disponibilidad"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginStart="8dp"
                android:text="@string/detalle_sin_disponibilidad"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/texto_categoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Granos" />

        <TextView
            android:id="@+id/texto_disponible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Disponible 3 de 5 kg" />

        <TextView
            android:id="@+id/texto_vence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Vence: 31/01/2027" />

        <TextView
            android:id="@+id/texto_maximo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Máximo por solicitud: 1,5 kg" />

        <!-- Donación Pendiente con un solo alimento: no se quita, se elimina la donación -->
        <TextView
            android:id="@+id/texto_ultimo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/detalle_quitar_ultimo"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Donación Pendiente con más de un alimento -->
        <FrameLayout
            android:id="@+id/contenedor_quitar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/boton_quitar"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="96dp"
                android:text="@string/alimento_quitar"
                android:textColor="?attr/colorError" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/indicador_quitar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorError"
                app:indicatorSize="20dp"
                app:trackThickness="3dp" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
