<?xml version="1.0" encoding="utf-8"?>
<!-- "Eliminar donación" (solo Pendiente): botón secundario de peligro con indicador de carga. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/aviso_error"
        style="@style/Widget.Kumora.AvisoError"
        android:layout_marginBottom="16dp"
        tools:text="Solo puedes eliminar una donación Pendiente."
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/boton_eliminar"
            style="@style/Widget.Kumora.Button.Peligro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/detalle_eliminar" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/indicador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorError"
            app:indicatorSize="24dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</LinearLayout>
