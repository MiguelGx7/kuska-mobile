<?xml version="1.0" encoding="utf-8"?>
<!-- Final de una lista paginada: cargando la siguiente página, o su error con "Reintentar". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="16dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/indicador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/cargando"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="24dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/texto_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="No hay conexión. Revisa tu internet e inténtalo de nuevo." />

    <Button
        android:id="@+id/boton_reintentar"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accion_reintentar" />
</LinearLayout>
