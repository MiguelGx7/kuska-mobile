<?xml version="1.0" encoding="utf-8"?>
<!--
  Resumen del inicio del beneficiario (HU-121), dentro de contenedor_resumen (se desplaza con la lista).
  El saludo va primero con la geometría de los títulos de pestaña: así la campana de MainActivity queda a su lado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/texto_saludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="@dimen/espacio_campana"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="Hola, Laura" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Con datos -->
        <LinearLayout
            android:id="@+id/contenido_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Kumora.CardView.Borde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/cifra_pendientes"
                            layout="@layout/vista_cifra"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/cifra_aprobadas"
                            layout="@layout/vista_cifra"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/texto_cupos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Puedes enviar 2 pedidos más" />

                    <TextView
                        android:id="@+id/aviso_limite"
                        style="@style/Widget.Kumora.AvisoAdvertencia"
                        android:layout_marginTop="12dp"
                        tools:text="Llegaste al límite de 3 pedidos activos. Podrás enviar otro cuando alguno se entregue o se cancele."
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Próxima recogida: destacada con el borde del color principal. Tocarla abre su detalle. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_recogida"
                style="@style/Widget.Kumora.CardView.Borde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/texto_titulo_recogida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_proxima_recogida"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/texto_fecha_recogida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Recoge antes del 20/10/2026 a las 18:30" />

                    <TextView
                        android:id="@+id/texto_pedido_recogida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Pedido KUM-20261016-0001" />

                    <TextView
                        android:id="@+id/texto_donacion_recogida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Donación: Mercado de la semana" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Si el resumen falla: un error pequeño; la lista de alimentos sigue funcionando -->
        <LinearLayout
            android:id="@+id/fila_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/texto_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="No pudimos cargar tu resumen." />

            <Button
                android:id="@+id/boton_reintentar"
                style="@style/Widget.Kumora.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/accion_reintentar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
