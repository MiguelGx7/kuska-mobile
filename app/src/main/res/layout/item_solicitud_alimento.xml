<?xml version="1.0" encoding="utf-8"?>
<!-- Alimento pedido: foto, nombre y cantidad. Si se canceló, nombre tachado y etiqueta "Cancelado" (HU-056). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kumora.CardView.Borde"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/miniatura"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/estado_gris_fondo"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Kumora.Control" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texto_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Arroz" />

            <TextView
                android:id="@+id/texto_cantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Cantidad: 2 kg" />

            <TextView
                android:id="@+id/etiqueta_cancelado"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginTop="6dp"
                android:text="@string/detalle_cancelado"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
