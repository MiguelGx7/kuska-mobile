<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una donación en Mis donaciones. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Kumora.CardView.Borde"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/miniatura"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/estado_gris_fondo"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Kumora.Control" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texto_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Mercado de la semana" />

            <TextView
                android:id="@+id/texto_alimentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="3 alimentos" />

            <TextView
                android:id="@+id/texto_fecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Creada el 16/10/2026" />

            <TextView
                android:id="@+id/etiqueta_estado"
                style="@style/Widget.Kumora.EtiquetaEstado"
                android:layout_marginTop="8dp"
                tools:text="Pendiente" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
