<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado del detalle: título, estado, modalidad, dirección, fechas y motivo del rechazo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/texto_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="Mercado de la semana" />

    <TextView
        android:id="@+id/etiqueta_estado"
        style="@style/Widget.Kumora.EtiquetaEstado"
        android:layout_marginTop="8dp"
        tools:text="Validada" />

    <TextView
        android:id="@+id/texto_descripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Productos en buen estado" />

    <TextView
        android:id="@+id/texto_modalidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Entrega: Ambas" />

    <TextView
        android:id="@+id/texto_direccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Recogida en: Calle 10 # 5-20, Bogotá" />

    <TextView
        android:id="@+id/texto_creada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Creada el 16/10/2026" />

    <TextView
        android:id="@+id/texto_revisada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Revisada el 17/10/2026" />

    <TextView
        android:id="@+id/aviso_rechazo"
        style="@style/Widget.Kumora.AvisoError"
        android:layout_marginTop="16dp"
        tools:text="Motivo del rechazo: La foto no muestra el alimento."
        tools:visibility="visible" />

    <!-- Error de la última acción (quitar, eliminar) o de editar/agregar si la donación ya no era Pendiente -->
    <TextView
        android:id="@+id/aviso_accion"
        style="@style/Widget.Kumora.AvisoError"
        android:layout_marginTop="16dp"
        tools:text="No se puede editar: la donación está Validada y debe estar Pendiente."
        tools:visibility="visible" />

    <!-- Solo en una donación Pendiente (RN-12) -->
    <Button
        android:id="@+id/boton_editar"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@string/detalle_editar"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Solo Validada o Agotada (RN-30): novedad sobre toda la donación -->
    <FrameLayout
        android:id="@+id/contenedor_novedad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/boton_novedad"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/novedad_boton_donacion" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/indicador_novedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="24dp"
            app:trackThickness="3dp" />
    </FrameLayout>

    <!-- Ya hay una novedad Pendiente sobre toda la donación -->
    <TextView
        android:id="@+id/etiqueta_novedad_revision"
        style="@style/Widget.Kumora.EtiquetaEstado"
        android:layout_marginTop="16dp"
        android:text="@string/novedad_en_revision"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
