<?xml version="1.0" encoding="utf-8"?>
<!--
  Inicio del donante (HU-035 a HU-037): saludo fijo arriba (con espacio para la campana) y debajo, desplazable,
  "Nueva donación", donaciones por estado, lo entregado y las series por mes y por categoría.
  Una cuenta sin donaciones ve solo la tarjeta que invita a crear la primera.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.iniciodonante.InicioDonanteFragment">

    <TextView
        android:id="@+id/texto_saludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="@dimen/espacio_campana"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="Hola, Laura" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/deslizar_refrescar"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/contenido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Cuenta nueva: invita a crear la primera donación -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tarjeta_vacia"
                        style="@style/Widget.Kumora.CardView.Borde"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_donaciones"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:text="@string/inicio_donante_vacio_titulo"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="@string/inicio_donante_vacio_mensaje"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <Button
                                android:id="@+id/boton_primera_donacion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:minHeight="48dp"
                                android:text="@string/inicio_donante_primera" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/seccion_datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/boton_nueva_donacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:text="@string/mis_donaciones_nueva" />

                        <!-- HU-035 -->
                        <TextView
                            style="@style/Widget.Kumora.TituloSeccionInicio"
                            android:text="@string/inicio_donante_estados" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Kumora.CardView.Borde"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/contenedor_estados"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingVertical="4dp" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- HU-036 -->
                        <TextView
                            style="@style/Widget.Kumora.TituloSeccionInicio"
                            android:text="@string/inicio_donante_entregado" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Kumora.CardView.Borde"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="false"
                                    android:orientation="horizontal">

                                    <include
                                        android:id="@+id/cifra_entregas"
                                        layout="@layout/vista_cifra"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" />

                                    <include
                                        android:id="@+id/cifra_alimentos"
                                        layout="@layout/vista_cifra"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" />

                                    <include
                                        android:id="@+id/cifra_personas"
                                        layout="@layout/vista_cifra"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/texto_cantidades"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Entregaste 12 kg · 30 unidades · 4 L" />

                                <TextView
                                    android:id="@+id/texto_sin_entregas"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/inicio_donante_sin_entregas"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- HU-037: últimos 12 meses -->
                        <TextView
                            style="@style/Widget.Kumora.TituloSeccionInicio"
                            android:text="@string/inicio_donante_meses" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.Kumora.CardView.Borde"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <include
                                    android:id="@+id/leyenda_meses"
                                    layout="@layout/vista_leyenda_series" />

                                <com.proyecto.kuska.ui.iniciodonante.GraficaMeses
                                    android:id="@+id/grafica_meses"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp" />

                                <TextView
                                    android:id="@+id/texto_sin_actividad"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/inicio_donante_sin_actividad"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- HU-037: por categoría -->
                        <TextView
                            android:id="@+id/titulo_categorias"
                            style="@style/Widget.Kumora.TituloSeccionInicio"
                            android:text="@string/inicio_donante_categorias" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/tarjeta_categorias"
                            style="@style/Widget.Kumora.CardView.Borde"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <include
                                    android:id="@+id/leyenda_categorias"
                                    layout="@layout/vista_leyenda_series" />

                                <LinearLayout
                                    android:id="@+id/contenedor_categorias"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include
            android:id="@+id/estado_pantalla"
            layout="@layout/vista_estado_pantalla"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
